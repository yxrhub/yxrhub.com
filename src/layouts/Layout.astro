---
import GoogleTag from "../components/GoogleTag.astro"
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import background from '../assets/background.svg';
---

<!doctype html>
<html lang="zh-cn">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="keywords" content="叶小睿, 云下人叶小睿, Yxr, YeXiaoRui, yxrhub, Yxr Space, 云下人无限世界" />
		<meta name="description" content="欢迎来到 YxrHub，这里是叶小睿（云下人叶小睿）的个人品牌大本营与数字空间，连接着 Yxr Space 数字花园与《云下人：无限世界》游戏构想。" />
		<title>YxrHub - 叶小睿 (Yxr) | 云下人叶小睿的数字空间 (Yxr Space)</title>
		{ import.meta.env.PROD && <GoogleTag/> }
	</head>
	<body>
		<div id="container">
			<img id="background" src={background.src} alt="" fetchpriority="high" />
			<Header />
			<main>
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	#container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		height: 100%;
		margin: 16px;
	}

	#background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		filter: blur(100px);
		user-select: none;
	}

	main {
		display: flex;
		flex-direction: column;
	}
</style>
