---
import GoogleTag from "../components/GoogleTag.astro"
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ImpersonationBanner from "../components/admin/ImpersonationBanner";
import background from '../assets/background.svg';

interface Props {
	/** 覆盖默认标题，供后台等非内容页使用 */
	title?: string;
	/** 非内容页应设为 true，避免被搜索引擎收录 */
	noindex?: boolean;
	/** 放宽内容宽度（默认 720px 是阅读向的栏宽，表格类界面不够用） */
	wide?: boolean;
}

const { title, noindex = false, wide = false } = Astro.props;

const DEFAULT_TITLE = "YxrHub - 叶小睿 (Yxr) | 云下人叶小睿的数字空间 (Yxr Space)";
---

<!doctype html>
<html lang="zh-cn">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0c0e18" media="(prefers-color-scheme: dark)" />
		<meta name="keywords" content="叶小睿, 云下人叶小睿, Yxr, YeXiaoRui, yxrhub, Yxr Space, 云下人无限世界" />
		<meta name="description" content="欢迎来到 YxrHub，这里是叶小睿（云下人叶小睿）的个人品牌大本营与数字空间，连接着 Yxr Space 数字花园与《云下人：无限世界》游戏构想。" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title ?? DEFAULT_TITLE}</title>
		{ import.meta.env.PROD && <GoogleTag/> }
	</head>
	<body>
		<img id="ambient" src={background.src} alt="" fetchpriority="high" aria-hidden="true" />
		<Header />
		<main class={wide ? "is-wide" : undefined}>
			<div class="wrap">
				<slot />
			</div>
		</main>
		<Footer />
		<ImpersonationBanner client:idle />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light dark;

		--bg: #fbfbfd;
		--surface: #ffffff;
		--surface-2: #f3f4f9;
		--border: rgba(16, 21, 40, 0.09);
		--border-strong: rgba(16, 21, 40, 0.18);

		--text: #101528;
		--text-2: #4a5268;
		--text-3: #8b92a6;

		--brand-blue: #3245ff;
		--brand-purple: #bc52ee;
		--brand-pink: #f041ff;
		--accent: #6b4bf0;

		/* 语义色。后台管理界面与模拟登录提示条共用，所以放在站点令牌里而不是各组件内。 */
		--danger: #d92d4a;
		--danger-soft: color-mix(in srgb, var(--danger) 12%, transparent);
		--ok: #1f9d63;
		--ok-soft: color-mix(in srgb, var(--ok) 14%, transparent);
		--warn: #b8770f;
		--warn-soft: color-mix(in srgb, var(--warn) 14%, transparent);

		--shadow: 0 1px 2px rgba(16, 21, 40, 0.04), 0 10px 28px -14px rgba(16, 21, 40, 0.16);

		--radius: 14px;
		--content: 720px;
		--font-sans: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
			"Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
		--font-mono: ui-monospace, "Cascadia Code", "Source Code Pro", Menlo, Consolas,
			"DejaVu Sans Mono", monospace;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #0c0e18;
			--surface: #151928;
			--surface-2: #1c2133;
			--border: rgba(255, 255, 255, 0.1);
			--border-strong: rgba(255, 255, 255, 0.2);

			--text: #eef0f8;
			--text-2: #a7aec4;
			--text-3: #7a8299;

			--accent: #9c8cff;

			--danger: #ff6f86;
			--ok: #4bd68c;
			--warn: #e0a94a;

			--shadow: 0 1px 2px rgba(0, 0, 0, 0.35), 0 12px 32px -16px rgba(0, 0, 0, 0.7);
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-height: 100vh;
		background: var(--bg);
		color: var(--text);
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.75;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	#ambient {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -1;
		pointer-events: none;
		user-select: none;
		filter: blur(80px) saturate(1.15);
		opacity: 0.5;
	}

	@media (prefers-color-scheme: dark) {
		#ambient {
			opacity: 0.22;
		}
	}

	.wrap {
		width: 100%;
		max-width: calc(var(--content) + 40px);
		margin: 0 auto;
		padding: 0 20px;
	}

	main {
		padding: 52px 0 8px;
	}

	main.is-wide .wrap {
		max-width: 1180px;
	}

	[id] {
		scroll-margin-top: 86px;
	}

	::selection {
		background: color-mix(in srgb, var(--accent) 26%, transparent);
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
		border-radius: 4px;
	}
</style>
