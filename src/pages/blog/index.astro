---
import Layout from "../../layouts/Layout.astro";
import {
    formatDate,
    getPostsNewestFirst,
    groupByYear,
    isoDate,
    readingMinutes,
} from "../../lib/blog";

const groups = groupByYear(await getPostsNewestFirst());
const total = groups.reduce((n, g) => n + g.posts.length, 0);
---

<Layout
    title="开发日志 — YxrHub"
    description="YxrHub 的开发日志：记录这个站点从零开始的目标、选型、重构与踩坑过程。"
>
    <header class="blog-head">
        <h1 class="blog-title">开发日志</h1>
        <p class="blog-intro">
            这个站本身就是作品之一。这里记录它从零开始的过程：为什么这样选型、哪次重构推翻了什么、
            以及那些花了很久才找到的坑。截至目前共 <strong>{total}</strong> 篇。
        </p>
    </header>

    {
        groups.map((group) => (
            <section class="year">
                <h2 class="year-label">
                    <span class="year-num">{group.year}</span>
                    <span class="year-count">{group.posts.length} 篇</span>
                </h2>
                <ol class="post-list">
                    {group.posts.map((post) => (
                        <li class="post">
                            <a class="post-link" href={`/blog/${post.id}`}>
                                <div class="post-row">
                                    <time class="post-date" datetime={isoDate(post.data.date)}>
                                        {formatDate(post.data.date)}
                                    </time>
                                    <span class="post-time">约 {readingMinutes(post)} 分钟</span>
                                </div>
                                <h3 class="post-title">{post.data.title}</h3>
                                <p class="post-summary">{post.data.summary}</p>
                            </a>
                        </li>
                    ))}
                </ol>
            </section>
        ))
    }

    <p class="blog-foot">
        <a href="/">← 回到首页</a>
    </p>
</Layout>

<style>
    .blog-head {
        margin-bottom: 46px;
    }

    .blog-title {
        font-size: clamp(28px, 5.2vw, 36px);
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.3;
        color: var(--text);
        margin: 0 0 12px;
    }

    .blog-intro {
        font-size: 15.5px;
        line-height: 1.9;
        color: var(--text-3);
        margin: 0;
        max-width: 58ch;
    }

    .blog-intro strong {
        color: var(--text-2);
        font-weight: 600;
    }

    /* ── 年份分组 ─────────────────────────────── */

    .year {
        margin-bottom: 40px;
    }

    .year:last-of-type {
        margin-bottom: 0;
    }

    .year-label {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin: 0 0 16px;
        padding-bottom: 9px;
        border-bottom: 1px solid var(--border);
    }

    .year-num {
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: var(--text-2);
        font-variant-numeric: tabular-nums;
    }

    .year-count {
        font-size: 12.5px;
        color: var(--text-3);
    }

    /* ── 文章条目 ─────────────────────────────── */

    .post-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 10px;
    }

    .post-link {
        display: block;
        padding: 15px 18px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--surface);
        text-decoration: none;
        transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
    }

    .post-link:hover {
        transform: translateY(-2px);
        border-color: var(--border-strong);
        background: var(--surface-2);
    }

    .post-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 6px;
    }

    .post-date {
        font-size: 12.5px;
        color: var(--accent);
        font-variant-numeric: tabular-nums;
    }

    .post-time {
        font-size: 12px;
        color: var(--text-3);
    }

    .post-time::before {
        content: "·";
        margin-right: 8px;
    }

    .post-title {
        font-size: 16.5px;
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.55;
        color: var(--text);
        margin: 0 0 5px;
    }

    .post-summary {
        font-size: 14px;
        line-height: 1.8;
        color: var(--text-3);
        margin: 0;
    }

    /* ── 页脚 ─────────────────────────────────── */

    .blog-foot {
        margin: 46px 0 0;
        font-size: 13.5px;
    }

    .blog-foot a {
        color: var(--text-3);
        text-decoration: none;
        transition: color 0.15s ease;
    }

    .blog-foot a:hover {
        color: var(--accent);
    }

    @media (max-width: 640px) {
        .blog-head {
            margin-bottom: 36px;
        }

        .post-link {
            padding: 14px 15px;
        }
    }
</style>
