---
import LoginButton from "./LoginButton";
---

<header class="site-header">
    <div class="wrap header-inner">
        <a class="brand" href="/">
            <span class="brand-mark">Yxr</span>Hub
        </a>
        <nav class="nav" aria-label="站内导航">
            <a href="#about">关于</a>
            <a href="#projects">项目</a>
            <a href="#find-me">足迹</a>
        </nav>
        <div class="account">
            <LoginButton client:idle />
        </div>
    </div>
</header>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: color-mix(in srgb, var(--bg) 76%, transparent);
        backdrop-filter: blur(14px) saturate(1.4);
        -webkit-backdrop-filter: blur(14px) saturate(1.4);
        border-bottom: 1px solid var(--border);
    }

    .header-inner {
        display: flex;
        align-items: center;
        gap: 18px;
        min-height: 62px;
    }

    .brand {
        font-size: 19px;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--text);
        text-decoration: none;
        white-space: nowrap;
    }

    .brand-mark {
        background: linear-gradient(96deg, var(--brand-blue), var(--brand-purple) 55%, var(--brand-pink));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .nav {
        display: flex;
        gap: 20px;
        margin-left: auto;
        font-size: 14px;
    }

    .nav a {
        color: var(--text-2);
        text-decoration: none;
        transition: color 0.15s ease;
    }

    .nav a:hover {
        color: var(--text);
    }

    .account {
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }

    @media (max-width: 620px) {
        .nav {
            display: none;
        }

        .account {
            margin-left: auto;
        }
    }
</style>
